<?php

/**
 * @file
 * Install and update functions for Agency.
 */

use Drupal\Core\Hook\Attribute\LegacyRequirementsHook;

/**
 * Implements hook_requirements().
 */
#[LegacyRequirementsHook]
function agency_requirements(string $phase): array {
  if ($phase !== 'runtime') {
    return [];
  }

  return agency_display_name_requirements();
}
