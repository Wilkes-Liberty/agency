<?php

/**
 * @file
 * Shared hooks for the Agency base module.
 */

/**
 * Returns the configured agency display name or refuses the operation.
 *
 * Invitation and participant-workspace entry points must call this function
 * before they render or mutate state. Keeping the guard in the base module
 * gives every capability the same fail-closed configuration boundary.
 *
 * @return string
 *   The trimmed agency display name.
 *
 * @throws \LogicException
 *   When the agency display name is absent or blank.
 */
function agency_require_display_name(): string {
  $display_name = trim((string) \Drupal::config('agency.settings')->get('display_name'));
  if ($display_name === '') {
    throw new \LogicException('Set the agency name before inviting anyone or rendering a participant workspace.');
  }

  return $display_name;
}
