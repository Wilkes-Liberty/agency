<?php

/**
 * @file
 * Access-checked commercial queries return no rows.
 */

use Drupal\Core\Database\Query\AlterableInterface;
use Drupal\Core\Database\Query\SelectInterface;

/**
 * Implements hook_query_TAG_alter() for agency_opportunity_access.
 */
function agency_commercial_query_agency_opportunity_access_alter(
  AlterableInterface $query,
): void {
  if ($query instanceof SelectInterface) {
    $query->where('1 = 0');
  }
}

/**
 * Implements hook_query_TAG_alter() for agency_activity_access.
 */
function agency_commercial_query_agency_activity_access_alter(
  AlterableInterface $query,
): void {
  if ($query instanceof SelectInterface) {
    $query->where('1 = 0');
  }
}
