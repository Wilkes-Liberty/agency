    'agency_migrate_write_log' => [
      'description' => 'Agency writes made after a domain became Agency-authoritative.',
      'fields' => [
        'wid' => [
          'type' => 'serial',
          'not null' => TRUE,
        ],
        'domain' => [
          'type' => 'varchar',
          'length' => 64,
          'not null' => TRUE,
        ],
        'entity_type' => [
          'type' => 'varchar',
          'length' => 64,
          'not null' => TRUE,
        ],
        'entity_id' => [
          'type' => 'int',
          'size' => 'big',
