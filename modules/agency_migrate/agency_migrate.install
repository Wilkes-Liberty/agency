          'length' => 64,
          'not null' => TRUE,
        ],
        'status' => [
          'type' => 'varchar',
          'length' => 32,
          'not null' => TRUE,
        ],
        'cursor_source_id' => [
          'type' => 'int',
          'size' => 'big',
          'not null' => TRUE,
          'default' => 0,
        ],
        'batch_size' => [
          'type' => 'int',
          'not null' => TRUE,
        ],
        'copied' => [
          'type' => 'int',
          'size' => 'big',
          'not null' => TRUE,
          'default' => 0,
