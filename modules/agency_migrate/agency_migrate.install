/**
 * Adds history qualification without inventing manifests for earlier copies.
 */
function agency_migrate_update_10001(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->fieldExists('agency_migrate_lineage', 'history_manifest')) {
    $definition = agency_migrate_schema()['agency_migrate_lineage']['fields']['history_manifest'];
    $schema->addField('agency_migrate_lineage', 'history_manifest', $definition);
  }
}

/**
 * Moves recorded authority from configuration into operational SQL state once.
 */
function agency_migrate_update_10002(): void {
  $database = \Drupal::database();
  $marker = new DatabaseStorage(
    'agency_migrate.authority_upgrade',
    new PhpSerialize(),
    $database,
  );
  if ($marker->get('initialized')) {
    if (!$database->schema()->tableExists('agency_migrate_authority_state')) {
      throw new \RuntimeException('Operational migration authority storage is unavailable.');
    }
    return;
  }
  \Drupal::configFactory()->reset('agency_migrate.authority');
  $domains = \Drupal::configFactory()->getEditable('agency_migrate.authority')->get('domains') ?? [];
  if (!is_array($domains)) {
    throw new \RuntimeException('Existing migration authority configuration is invalid.');
  }
  foreach ($domains as $domain => $row) {
    if (!is_string($domain) || !preg_match('/^[a-z][a-z0-9_]{0,62}$/', $domain)
      || !is_array($row) || !in_array($row['state'] ?? NULL, ['legacy', 'shadow', 'agency', 'removed'], TRUE)
      || !is_int($row['changed'] ?? NULL) || $row['changed'] < 0
      || !is_string($row['actor_hash'] ?? NULL) || !preg_match('/^[a-f0-9]{64}$/', $row['actor_hash'])
      || !is_string($row['reason'] ?? NULL) || trim($row['reason']) === '' || strlen($row['reason']) > 255) {
      throw new \RuntimeException('Existing migration authority configuration is invalid.');
    }
  }
  if (!$database->schema()->tableExists('agency_migrate_authority_state')) {
    $database->schema()->createTable('agency_migrate_authority_state', agency_migrate_schema()['agency_migrate_authority_state']);
  }
  $transaction = $database->startTransaction();
  try {
    foreach ($domains as $domain => $row) {
      if (!$database->select('agency_migrate_authority_state', 'a')->condition('domain', $domain)->countQuery()->execute()->fetchField()) {
        $database->insert('agency_migrate_authority_state')->fields([
          'domain' => $domain,
          'state' => $row['state'],
          'version' => 1,
          'changed' => $row['changed'],
          'actor_hash' => $row['actor_hash'],
          'reason' => $row['reason'],
        ])->execute();
      }
    }
    // This explicit SQL key/value store shares the authority transaction.
    $marker->set('initialized', TRUE);
    TransactionBoundary::commit($transaction);
  }
  catch (\Throwable $exception) {
    $transaction?->rollBack();
    throw $exception;
  }
}

/**
 * Implements hook_install().
 */
function agency_migrate_install(): void {
  agency_migrate_update_10003();
}

/**
 * Allowed creation state for Slice 2 authority rows.
 */
function agency_migrate_s2_create_state(string $state): string {
  if ($state !== 'legacy') {
    throw new \RuntimeException('Slice two domains may only be created at legacy.');
  }
  return $state;
}

/**
 * Registers workforce and recruiting at legacy without changing other rows.
 */
function agency_migrate_update_10003(): void {
  $database = \Drupal::database();
  if (!$database->schema()->tableExists('agency_migrate_authority_state')) {
    throw new \RuntimeException('Operational migration authority storage is unavailable.');
  }
  $state = agency_migrate_s2_create_state('legacy');
  $now = \Drupal::time()->getCurrentTime();
  $actor_hash = hash('sha256', 'uid:' . \Drupal::currentUser()->id());
  $reason = 'Register slice two domains at legacy';
  $transaction = $database->startTransaction();
  try {
    foreach (['workforce', 'recruiting'] as $domain) {
      $query = $database->select('agency_migrate_authority_state', 'a')
        ->fields('a', ['domain'])
        ->condition('domain', $domain);
      $query->forUpdate();
      if ($query->execute()->fetchField()) {
        continue;
      }
      try {
        $database->insert('agency_migrate_authority_state')->fields([
          'domain' => $domain,
          'state' => $state,
          'version' => 1,
          'changed' => $now,
          'actor_hash' => $actor_hash,
          'reason' => $reason,
        ])->execute();
      }
      catch (IntegrityConstraintViolationException) {
        // A concurrent installer won the unique domain key.
      }
    }
    TransactionBoundary::commit($transaction);
  }
  catch (\Throwable $exception) {
    $transaction?->rollBack();
    throw $exception;
  }
}

/**
 * Adds nullable operation envelopes without qualifying historical write rows.
 */
function agency_migrate_update_10004(): void {
  $database = \Drupal::database();
  $schema = $database->schema();
  $definition = agency_migrate_schema()['agency_migrate_write_log'];
  foreach (['envelope_version', 'authority_generation', 'operation_id', 'request_hash', 'envelope'] as $field) {
    if (!$schema->fieldExists('agency_migrate_write_log', $field)) {
      $schema->addField('agency_migrate_write_log', $field, $definition['fields'][$field]);
    }
  }
  $unique_exists = $schema->indexExists('agency_migrate_write_log', 'domain_operation');
  // PostgreSQL distinguishes a unique constraint from an ordinary index.
  if (!$unique_exists && $database->driver() === 'pgsql' && method_exists($schema, 'constraintExists')) {
    $unique_exists = $schema->constraintExists('agency_migrate_write_log', 'domain_operation__key');
  }
  if (!$unique_exists) {
    $schema->addUniqueKey('agency_migrate_write_log', 'domain_operation', $definition['unique keys']['domain_operation']);
  }
}
