        'content_digest' => [
          'type' => 'varchar',
          'length' => 64,
          'not null' => TRUE,
        ],
        'history_manifest' => [
          'description' => 'Versioned revision digests; NULL means history has not been verified.',
          'type' => 'text',
          'size' => 'big',
          'not null' => FALSE,
        ],
        'recorded' => [
          'type' => 'int',
          'size' => 'big',
          'not null' => TRUE,
        ],
      ],
