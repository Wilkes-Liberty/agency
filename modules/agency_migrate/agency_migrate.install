          'not null' => TRUE,
        ],
        'updated' => [
          'type' => 'int',
          'size' => 'big',
          'not null' => TRUE,
        ],
        'finished' => [
          'type' => 'int',
          'size' => 'big',
          'not null' => FALSE,
        ],
        'error' => [
          'type' => 'varchar',
          'length' => 64,
          'not null' => FALSE,
        ],
      ],
      'primary key' => ['run_id'],
      'indexes' => [
        'plugin_status' => ['plugin_id', 'status'],
      ],
    ],
    'agency_migrate_outbox' => [
      'description' => 'Minimized lineage and authority intents for Audit Chain.',
      'fields' => [
