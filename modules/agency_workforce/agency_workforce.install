<?php

/**
 * @file
 * Durable workforce exclusion, operation receipts and minimized evidence.
 */

/**
 * Implements hook_schema().
 */
function agency_workforce_schema(): array {
  $id = ['type' => 'varchar', 'length' => 36, 'ascii' => TRUE, 'not null' => TRUE];
  $scope = ['type' => 'varchar', 'length' => 64, 'ascii' => TRUE, 'not null' => TRUE];
  $operation = ['type' => 'varchar', 'length' => 32, 'ascii' => TRUE, 'not null' => TRUE];
  $time = ['type' => 'int', 'size' => 'big', 'not null' => TRUE];
  return [
    'agency_workforce_mutex' => [
      'description' => 'Durable contact/invitation exclusion; no bearer or contact values.',
      'fields' => [
        'lock_key' => ['type' => 'varchar', 'length' => 384, 'ascii' => TRUE, 'not null' => TRUE],
      ],
      'primary key' => ['lock_key'],
    ],
    'agency_workforce_receipt' => [
      'description' => 'New operation receipts, not fabricated source invitation identifiers.',
      'fields' => [
        'id' => $id,
        'scope' => $scope,
        'collection' => ['type' => 'varchar', 'length' => 128, 'ascii' => TRUE, 'not null' => TRUE],
        'digest' => ['type' => 'varchar', 'length' => 64, 'ascii' => TRUE, 'not null' => TRUE],
        'operation' => $operation,
        'binding' => ['type' => 'varchar', 'length' => 255, 'ascii' => TRUE, 'not null' => FALSE],
        'recorded' => $time,
      ],
      'primary key' => ['id'],
      'unique keys' => [
        'source_operation' => ['scope', 'collection', 'digest', 'operation'],
      ],
    ],
    'agency_workforce_outbox' => [
      'description' => 'Required minimized intents; delivered only after business commit.',
      'fields' => [
        'id' => $id,
        'operation' => $operation,
        'metadata' => ['type' => 'text', 'size' => 'normal', 'not null' => TRUE],
        'recorded' => $time,
        'delivered' => ['type' => 'int', 'size' => 'big', 'not null' => FALSE],
        'attempts' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
      ],
      'primary key' => ['id'],
      'indexes' => ['pending' => ['delivered', 'recorded']],
    ],
  ];
}
