{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://www.drupal.org/project/agency/ontology/actions.schema.json",
  "title": "Agency action types",
  "description": "Named, permissioned writes and the registered Discovery reads.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "target_type",
      "status",
      "input_schema",
      "validation_rules",
      "permission",
      "evidence",
      "idempotency_key",
      "reduces_access"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      },
      "target_type": {
        "type": "string",
        "pattern": "^[A-Z][A-Za-z0-9]+$"
      },
      "status": {
        "type": "string",
        "enum": ["implemented", "proposed"]
      },
      "slice": {
        "type": "string",
        "enum": ["S1", "S2", "S3", "S4", "S5"]
      },
      "owning_service": {
        "type": "string"
      },
      "input_schema": {
        "type": "object"
      },
      "validation_rules": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "permission": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "drupal_permission",
              "entitled_principal",
              "invitation_token",
              "maintenance_permission"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "approval_rule": {
        "type": ["string", "null"]
      },
      "evidence": {
        "type": "object",
        "additionalProperties": false,
        "required": ["emitted", "fields", "forbidden"],
        "properties": {
          "emitted": {
            "type": "boolean"
          },
          "when": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "forbidden": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "idempotency_key": {
        "type": "object",
        "additionalProperties": false,
        "required": ["required", "pattern"],
        "properties": {
          "required": {
            "type": "boolean"
          },
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "fingerprint": {
            "type": "string"
          }
        }
      },
      "reduces_access": {
        "type": "boolean"
      },
      "notes": {
        "type": "string"
      }
    }
  }
}
