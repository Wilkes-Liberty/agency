<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="agency">
  <description>PHP CodeSniffer ruleset for the Agency module.</description>

  <file>.</file>
  <arg name="extensions" value="php,module,inc,install,test,profile,theme,yml"/>
  <arg name="colors"/>
  <arg value="sp"/>

  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>

  <!-- Ported host adapter: comments often sit one character over 80, and
       Form API classes still call \Drupal:: for time and services. -->
  <rule ref="Drupal.Files.LineLength.TooLong">
    <exclude-pattern>*/modules/agency_host/*</exclude-pattern>
  </rule>
  <rule ref="DrupalPractice.Objects.GlobalDrupal.GlobalDrupal">
    <exclude-pattern>*/modules/agency_host/*</exclude-pattern>
  </rule>
</ruleset>
