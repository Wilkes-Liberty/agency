# PHPStan configuration for Agency.
# Drupal CI provides phpstan-drupal and analyses the module in place.
includes:
  - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:
  level: 6
  reportUnmatchedIgnoredErrors: false
  paths:
    - .
  excludePaths:
    - vendor (?)
    # Ported host adapter: optional smtp/postmark plugins, form \Drupal::
    # calls, and kernel fixtures are not yet at the package baseline.
    # Keep analysing agency and agency_staff; follow up on agency_host.
    - modules/agency_host
  fileExtensions:
    - php
    - module
    - inc
    - install
  ignoreErrors:
    - identifier: missingType.iterableValue
    - identifier: missingType.generics
    # PHPUnit 9 on Drupal 10.6 has no Attributes namespace. PHP treats the
    # unresolved attributes as inert there; PHPUnit 11 uses them on Drupal 11.
    - "#Attribute class PHPUnit.*Attributes.* does not exist#"
