<?php

/**
 * @file
 * Synthetic first-party host storage; never operational invitation data.
 */

/**
 * Implements hook_schema().
 */
function agency_workforce_test_schema(): array {
  return [
    'agency_workforce_test_invitation' => [
      'fields' => [
        'collection' => ['type' => 'varchar', 'length' => 128, 'not null' => TRUE],
        'name' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
        'value' => ['type' => 'text', 'not null' => TRUE],
        'expire' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE],
      ],
      'primary key' => ['collection', 'name'],
    ],
    'agency_workforce_test_profile' => [
      'fields' => [
        'uid' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE],
        'classification' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE],
        'language' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE],
      ],
      'primary key' => ['uid'],
    ],
    'agency_workforce_test_authority' => [
      'fields' => [
        'scope' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
        'state' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE],
      ],
      'primary key' => ['scope'],
    ],
  ];
}
